{
  "name": "comfoair-hausgrafik-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/comfoair-hausgrafik.ts --bundle --outfile=comfoair-hausgrafik.js --format=iife --minify --target=es2020 && esbuild src/editor.ts --bundle --outfile=comfoair-hausgrafik-editor.js --format=iife --minify --target=es2020",
    "dev": "esbuild src/comfoair-hausgrafik.ts --bundle --outfile=comfoair-hausgrafik.js --format=iife --target=es2020 --sourcemap --watch & esbuild src/editor.ts --bundle --outfile=comfoair-hausgrafik-editor.js --format=iife --target=es2020 --sourcemap --watch & wait",
    "clean": "rm -f comfoair-hausgrafik.js comfoair-hausgrafik-editor.js comfoair-hausgrafik.js.map comfoair-hausgrafik-editor.js.map"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
